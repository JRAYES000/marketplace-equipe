# Recuperation des posts a commenter (acteur harvestapi/linkedin-profile-posts)
APIFY_TOKEN=

# Publication du commentaire (LINKEDIN_CREATE_COMMENT_ON_POST), canal MCP consumer
# (https://connect.composio.dev/mcp) -- cle "ck_..." (Reglages du compte personnel Composio ->
# "Sessions & API Key", surface "FOR YOU"). PAS une cle "ak_..." (couche PLATFORM, admin
# d'organisation) : ce format n'existe pas sur ce compte et le canal REST qui l'utilisait est une
# voie morte -- voir references/actions-composio.md et lib/composio.js.
COMPOSIO_CONSUMER_API_KEY=

# Page Notion de suivi des commentaires (lib/notion.js, creer-page-notion.js)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
