# Recuperation des posts a commenter (acteur harvestapi/linkedin-profile-posts)
APIFY_TOKEN=

# Publication du commentaire (LINKEDIN_CREATE_COMMENT_ON_POST) pour julien-agency, canal MCP
# consumer (https://connect.composio.dev/mcp) -- cle "ck_..." (Reglages du compte personnel
# Composio -> "Sessions & API Key", surface "FOR YOU"). PAS une cle "ak_..." (couche PLATFORM,
# admin d'organisation) : ce format n'existe pas sur ce canal -- voir references/actions-composio.md
# et lib/composio.js.
COMPOSIO_CONSUMER_API_KEY=

# Publication pour julien-partners depuis le 17/09/2026, canal REST direct
# (backend.composio.dev/api/v3.1) -- cle de PROJET "ak_..." (Composio -> parametres du projet),
# PAS la cle consumer ci-dessus. Voir lib/composio-canal.js (ROUTAGE_COMPTES) et
# references/actions-composio.md, section "17/09/2026 (suite)".
COMPOSIO_API_KEY=

# Page Notion de suivi des commentaires (lib/notion.js, creer-page-notion.js)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
